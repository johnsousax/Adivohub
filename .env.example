# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Este arquivo traz só os NOMES das variáveis. Nenhum valor real deve ser commitado.
# Use valores diferentes em cada ambiente (produção, pré-visualização, desenvolvimento).

# --- Sessão -------------------------------------------------------------------
# Segredo que assina o cookie de sessão. Obrigatório em produção, com 32 caracteres ou mais.
# Gere com: openssl rand -base64 48
# Trocar este valor derruba todas as sessões abertas.
AUTH_SECRET=

# --- Demonstração pública -----------------------------------------------------
# A demonstração não tem senha: o visitante só vê dados fictícios, guardados no
# navegador dele, e a IA responde por regras prontas (nunca usa a chave paga).
# Para desligar o botão "Abrir a demonstração", defina como false.
DEMO_PUBLICA=

# --- Acesso privado (opcional) --------------------------------------------------
# Conta única, usada enquanto não há banco de usuários. Sem estas variáveis, o
# login por e-mail e senha não aceita ninguém. Não existe senha padrão.
# ACESSO_SENHA_HASH é o HASH da senha, nunca a senha: gere com `npm run senha`.
ACESSO_EMAIL=
ACESSO_SENHA_HASH=
# Nome mostrado no painel para quem entra pelo acesso privado.
ACESSO_NOME=

# --- Inteligência Artificial (opcional) ---------------------------------------
# Sem a chave, o assistente e o atendente respondem com regras locais.
# Com a chave, a IA paga responde SÓ ao acesso privado.
ANTHROPIC_API_KEY=
# Modelos (opcionais). Padrão: claude-opus-5-5 para os dois.
# Para reduzir custo: ANTHROPIC_MODEL_ATENDIMENTO=claude-haiku-5-5
ANTHROPIC_MODEL_ASSISTENTE=
ANTHROPIC_MODEL_ATENDIMENTO=
# Teto de chamadas pagas de IA por usuário a cada 24 horas. Padrão: 300.
IA_COTA_DIARIA=

# --- WhatsApp Business Platform (opcional) ------------------------------------
# Token de verificação e segredo do aplicativo, usados pelo webhook da Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Dados sensíveis (para quando o banco for conectado) -----------------------
# Chaves que cifram CPF e CNPJ de clientes antes de irem para o banco.
# Duas chaves diferentes, de 32 bytes. Gere cada uma com: openssl rand -base64 32
# Guarde uma cópia em cofre de senhas: sem a CHAVE_DE_DADOS, os documentos não voltam.
CHAVE_DE_DADOS=
CHAVE_DE_INDICE=

# --- Site ---------------------------------------------------------------------
# Só é necessária para forçar um endereço específico nos links de compartilhamento.
NEXT_PUBLIC_SITE_URL=
