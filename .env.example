# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Nenhum destes valores deve ser commitado.

# --- Sessão / login -----------------------------------------------------------
# Segredo usado para assinar o cookie de sessão. Obrigatório em produção.
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Credenciais do acesso de demonstração (opcionais; estes são os padrões).
# Troque a senha antes de ligar a chave da IA, para ninguém gastar seus créditos.
DEMO_EMAIL=demo@vade.example
DEMO_SENHA=vade2026

# --- Inteligência Artificial (opcional) ---------------------------------------
# Sem a chave, o assistente e o atendente funcionam em "modo demonstração",
# respondendo com regras locais a partir dos dados do escritório.
ANTHROPIC_API_KEY=
# Modelos (opcionais). Padrão: claude-opus-5-5 para os dois.
# Para reduzir custo: ANTHROPIC_MODEL_ATENDIMENTO=claude-haiku-5-5
ANTHROPIC_MODEL_ASSISTENTE=
ANTHROPIC_MODEL_ATENDIMENTO=

# --- WhatsApp Business Platform (opcional, ainda não conectado) ---------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Site ---------------------------------------------------------------------
# URL pública (sem barra no final). Na Vercel é detectada automaticamente.
NEXT_PUBLIC_SITE_URL=
